{
  "train_batch_size" : 128,
  "train_micro_batch_size_per_gpu" : 1,

  "optimizer": {
    "type": "Adam",
    "params": {
      "lr": 0.001,
      "betas": [
        0.9,
        0.999
      ],
      "eps": 1e-8
    }
  },

  "zero_optimization": {
    "stage": 1,
    "offload_optimizer": {
      "device": "cpu"
    },
    "allgather_partitions": true,
    "reduce_scatter": true,
    "overlap_comm": true,
    "contiguous_gradients": true
  },

  "steps_per_print" : 1,
  "wall_clock_breakdown" : true
}